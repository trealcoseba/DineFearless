@page "/community"
@rendermode InteractiveServer

@using DineFearless.Components.Sections
@inject NavigationManager Nav

<PageTitle>Community Kitchen Audits - DineFearless</PageTitle>

<div class="min-h-screen bg-slate-50 font-sans text-slate-900 pb-16">
    <TopNav />

    <main class="max-w-[1100px] mx-auto px-8 pt-8">
        <div class="flex items-center justify-between mb-8">
            <div>
                <span class="text-[11px] font-extrabold tracking-widest uppercase text-emerald-800">Diner-Verified Safety</span>
                <h1 class="text-3xl font-black tracking-tight text-slate-900 mt-1">Community Audits & Reports</h1>
                <p class="text-sm text-slate-500">Real-time reports on fryer contamination, server attentiveness, and clean prep areas.</p>
            </div>

            <button class="px-4 py-2.5 rounded-xl bg-emerald-800 text-white font-bold text-xs shadow-xs hover:bg-emerald-900 transition cursor-pointer">
                + Submit Kitchen Audit
            </button>
        </div>

        <div class="space-y-4">
            @foreach (var audit in _audits)
            {
                <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-xs flex items-start justify-between">
                    <div>
                        <div class="flex items-center gap-3">
                            <h3 class="font-bold text-lg text-slate-900">@audit.RestaurantName</h3>
                            <span class="bg-emerald-100 text-emerald-800 text-xs font-bold px-2.5 py-0.5 rounded-full">
                                ✓ Verified Celiac Safe
                            </span>
                            <span class="text-xs text-slate-400">• @audit.DateAgo</span>
                        </div>

                        <p class="mt-2 text-sm text-slate-700 leading-relaxed max-w-2xl">
                            "@audit.Comment"
                        </p>

                        <div class="mt-4 flex items-center gap-2">
                            <span class="text-xs font-bold text-slate-400">Allergy Profile Tested:</span>
                            @foreach (var tag in audit.Tags)
                            {
                                <span class="bg-slate-100 text-slate-700 font-semibold text-[11px] px-2.5 py-0.5 rounded-md">
                                    @tag
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Interactive Upvote Button -->
                    <button @onclick="() => Upvote(audit)"
                            class="flex flex-col items-center justify-center w-16 h-16 rounded-2xl border transition cursor-pointer @(audit.HasUpvoted ? "bg-emerald-800 border-emerald-800 text-white" : "bg-slate-50 border-slate-200 text-slate-700 hover:bg-slate-100")">
                        <span class="text-xs">▲</span>
                        <span class="text-xs font-black">@audit.Upvotes</span>
                    </button>
                </div>
            }
        </div>
    </main>
</div>

@code {
    private class AuditItem
    {
        public string RestaurantName { get; set; } = "";
        public string Comment { get; set; } = "";
        public string DateAgo { get; set; } = "";
        public string[] Tags { get; set; } = Array.Empty<string>();
        public int Upvotes { get; set; }
        public bool HasUpvoted { get; set; }
    }

    private readonly List<AuditItem> _audits = new()
    {
        new() {
            RestaurantName = "Artisan Kitchen",
            Comment = "Manager came out personally to double-check their dedicated corn fryer. Zero gluten reaction, amazing experience!",
            DateAgo = "2 days ago",
            Tags = new[] { "Celiac", "Gluten-Free", "Shellfish" },
            Upvotes = 42,
            HasUpvoted = false
        },
        new() {
            RestaurantName = "Green Fork Bistro",
            Comment = "Completely vegan prep line. No butter or dairy cross-contamination whatsoever. Super allergy-friendly staff.",
            DateAgo = "5 days ago",
            Tags = new[] { "Dairy-Free", "Vegan" },
            Upvotes = 28,
            HasUpvoted = false
        }
    };

    private void Upvote(AuditItem item)
    {
        if (item.HasUpvoted)
        {
            item.Upvotes--;
            item.HasUpvoted = false;
        }
        else
        {
            item.Upvotes++;
            item.HasUpvoted = true;
        }
    }
}