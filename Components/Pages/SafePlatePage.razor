@page "/safe-plate"
@rendermode InteractiveServer

@using DineFearless.Models
@using DineFearless.Services
@using DineFearless.Components.Sections
@inject SafePlateService PlateService
@inject UserDietaryProfile Profile
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>My Safe Plate Checkout - DineFearless</PageTitle>

<div class="min-h-screen bg-slate-50 font-sans text-slate-900 pb-20">
    <TopNav />

    <main class="max-w-[1440px] mx-auto px-8 pt-8">
        <!-- Top Nav & Header -->
        <div class="flex items-center justify-between mb-8 pb-6 border-b border-slate-200">
            <div>
                <button @onclick='() => Nav.NavigateTo("/restaurant/artisan-kitchen")' 
                        class="text-xs font-extrabold uppercase tracking-widest text-emerald-800 hover:text-emerald-900 flex items-center gap-1.5 transition cursor-pointer mb-2">
                    <span>←</span> Back to Artisan Kitchen Menu
                </button>
                <h1 class="text-3xl font-black tracking-tight text-slate-900">Review Safe Selection</h1>
                <p class="text-sm text-slate-500 mt-1">
                    Present this curated tray and your verified allergy checklist directly to your server.
                </p>
            </div>

            <!-- Total Items Pill -->
            <div class="flex items-center gap-2 bg-emerald-50 border border-emerald-200/80 px-4 py-2 rounded-full shadow-2xs">
                <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
                <span class="text-xs font-bold text-emerald-900">
                    @PlateService.TotalCount @(PlateService.TotalCount == 1 ? "Selected Item" : "Selected Items")
                </span>
            </div>
        </div>

        @if (!PlateService.Items.Any())
        {
            <div class="max-w-xl mx-auto py-16 text-center bg-white rounded-3xl border border-slate-200 shadow-xs p-8">
                <div class="w-16 h-16 mx-auto rounded-2xl bg-slate-100 flex items-center justify-center text-3xl mb-4">🍽</div>
                <h3 class="text-xl font-bold text-slate-900">Your safe plate is empty</h3>
                <p class="text-sm text-slate-500 mt-2 mb-6">Return to the menu to pick dishes verified safe for your dietary profile.</p>
                <button @onclick='() => Nav.NavigateTo("/restaurant/artisan-kitchen")' 
                        class="px-6 py-3 rounded-xl bg-emerald-800 hover:bg-emerald-900 text-white font-bold text-xs transition cursor-pointer shadow-xs">
                    Browse Menu
                </button>
            </div>
        }
        else
        {
            <div class="grid grid-cols-12 gap-8 items-start">
                <!-- Left 8 Columns: Dish List -->
                <div class="col-span-8 space-y-4">
                    @foreach (var item in PlateService.Items)
                    {
                        <div class="bg-white p-5 rounded-3xl border border-slate-200 shadow-xs flex items-center justify-between gap-6 hover:border-slate-300 transition">
                            <div class="flex items-center gap-5 min-w-0">
                                <img src="@item.Dish.ImageUrl" alt="@item.Dish.Name" class="w-24 h-24 rounded-2xl object-cover shrink-0 shadow-2xs border border-slate-100" />
                                <div class="min-w-0">
                                    <h3 class="text-lg font-bold text-slate-900 truncate">@item.Dish.Name</h3>
                                    <span class="inline-flex items-center gap-1 text-[11px] font-bold px-2.5 py-0.5 rounded-md bg-emerald-50 text-emerald-800 border border-emerald-200/60 mt-1">
                                        ✓ @item.StatusNote
                                    </span>
                                    <p class="text-xs text-slate-400 mt-1.5">
                                        Unit price: <span class="font-bold text-slate-700">@item.Dish.Price.ToString("C0")</span>
                                    </p>
                                </div>
                            </div>

                            <div class="flex items-center gap-6 shrink-0">
                                <!-- Quantity Stepper -->
                                <div class="flex items-center border border-slate-200 rounded-xl bg-slate-50 p-1 shadow-2xs">
                                    <button @onclick="() => PlateService.UpdateQuantity(item.Dish, -1)" class="w-8 h-8 rounded-lg bg-white hover:bg-slate-100 text-slate-800 font-bold text-sm flex items-center justify-center transition shadow-2xs cursor-pointer active:scale-95">-</button>
                                    <span class="w-10 text-center font-bold text-sm text-slate-900 select-none">@item.Quantity</span>
                                    <button @onclick="() => PlateService.UpdateQuantity(item.Dish, 1)" class="w-8 h-8 rounded-lg bg-white hover:bg-slate-100 text-slate-800 font-bold text-sm flex items-center justify-center transition shadow-2xs cursor-pointer active:scale-95">+</button>
                                </div>

                                <div class="w-24 text-right">
                                    <div class="text-xl font-black text-slate-900">
                                        @((item.Dish.Price * item.Quantity).ToString("C0"))
                                    </div>
                                </div>

                                <button @onclick="() => PlateService.Remove(item.Dish)" class="w-8 h-8 rounded-xl text-slate-400 hover:text-rose-600 hover:bg-rose-50 flex items-center justify-center transition cursor-pointer text-base">✕</button>
                            </div>
                        </div>
                    }

                    <!-- Kitchen Instruction Checklist -->
                    <div class="bg-emerald-50/70 border border-emerald-200/80 p-6 rounded-3xl mt-6">
                        <div class="flex items-center gap-2 mb-2">
                            <span class="text-emerald-800 font-bold text-base">🛡</span>
                            <h4 class="font-bold text-sm text-emerald-950 uppercase tracking-wide">Kitchen Instructions for this Plate:</h4>
                        </div>
                        <ul class="space-y-2 text-xs text-emerald-900 font-medium">
                            <li class="flex items-center gap-2">
                                <span class="text-emerald-700 font-bold">✓</span> Table flagged for <span class="font-bold">@string.Join(" & ", Profile.ActiveAllergens)</span> exclusion.
                            </li>
                            <li class="flex items-center gap-2">
                                <span class="text-emerald-700 font-bold">✓</span> Chef confirmation required for dedicated fryer & clean utensils.
                            </li>
                            <li class="flex items-center gap-2">
                                <span class="text-emerald-700 font-bold">✓</span> No shared cross-contact preparation surfaces.
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Right 4 Columns: Sticky Summary Card -->
                <div class="col-span-4 sticky top-28">
                    <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-xs space-y-5">
                        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                            <h3 class="font-bold text-lg text-slate-900">Order Summary</h3>
                            <span class="text-xs text-slate-400 font-medium">Artisan Kitchen</span>
                        </div>

                        <div class="flex justify-between items-center text-sm">
                            <span class="text-slate-500 font-medium">Items Subtotal</span>
                            <span class="font-bold text-slate-900">@PlateService.EstimatedTotal.ToString("C2")</span>
                        </div>

                        <div class="flex justify-between items-center text-sm">
                            <span class="text-slate-500 font-medium flex items-center gap-1">
                                Kitchen Protocol Verification
                                <span class="text-emerald-600 font-bold">✓</span>
                            </span>
                            <span class="text-xs font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md">Free</span>
                        </div>

                        <!-- Interactive Tip Selector -->
                        <div class="pt-2">
                            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider block mb-2">Include Kitchen Tip:</span>
                            <div class="grid grid-cols-3 gap-2">
                                @foreach (var tip in new[] { 15, 18, 20 })
                                {
                                    <button @onclick="() => _selectedTip = tip" 
                                            class="py-2.5 rounded-xl text-xs font-bold transition cursor-pointer @(_selectedTip == tip ? "bg-emerald-800 text-white shadow-2xs" : "bg-slate-100 text-slate-700 hover:bg-slate-200")">
                                        @tip%
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="pt-4 border-t border-slate-100 flex justify-between items-baseline">
                            <div>
                                <span class="font-bold text-sm text-slate-900 block leading-tight">Estimated Total</span>
                                <span class="text-[11px] text-slate-400">Includes @_selectedTip% tip</span>
                            </div>
                            <span class="font-black text-2xl text-slate-900">
                                @((PlateService.EstimatedTotal * (1 + _selectedTip / 100m)).ToString("C2"))
                            </span>
                        </div>

                        <div class="p-3 bg-amber-50 rounded-2xl border border-amber-200/60 text-[11px] text-amber-900 leading-relaxed font-medium">
                            Note: DineFearless does not process table payments. Present this screen to your server when ordering.
                        </div>

                        <button @onclick='() => Nav.NavigateTo("/restaurant/artisan-kitchen")' 
                                class="w-full py-3.5 bg-emerald-800 hover:bg-emerald-900 text-white font-bold text-xs rounded-xl transition cursor-pointer shadow-xs active:scale-98 flex items-center justify-center gap-2">
                            <span>📋</span> Show Server Handover Card →
                        </button>
                    </div>
                </div>
            </div>
        }
    </main>
</div>

@code {
    private int _selectedTip = 18;

    protected override void OnInitialized() => PlateService.OnPlateChanged += StateHasChanged;
    public void Dispose() => PlateService.OnPlateChanged -= StateHasChanged;
}