@using DineFearless.Models
@using DineFearless.Services
@inject UserDietaryProfile Profile
@inject ModalService Modals
@implements IDisposable

<aside class="w-72 shrink-0 bg-white border border-slate-200 rounded-3xl p-6 shadow-xs flex flex-col justify-between">
    <div class="space-y-6">
        <!-- Title -->
        <div class="flex items-center justify-between pb-2 border-b border-slate-100">
            <h3 class="font-bold text-lg text-slate-900">Dietary Filters</h3>
            <span class="text-slate-400 hover:text-slate-600 cursor-pointer">⚙</span>
        </div>

        <!-- Allergens Section -->
        <div>
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs uppercase font-bold text-slate-400 tracking-wider">Allergens to Avoid</span>
                <span class="text-xs font-semibold text-rose-600">@Profile.ActiveAllergens.Count active</span>
            </div>
            
            <div class="space-y-2">
                @foreach (AllergenType allergen in Enum.GetValues<AllergenType>())
                {
                    var isSelected = Profile.ActiveAllergens.Contains(allergen);
                    <div @onclick="() => Profile.ToggleAllergen(allergen)"
                         class="flex items-center justify-between p-2.5 rounded-xl border transition cursor-pointer select-none @(isSelected ? "bg-rose-50/50 border-rose-200" : "bg-white border-slate-200 hover:bg-slate-50")">
                        <div class="flex items-center gap-3">
                            <div class="w-5 h-5 rounded-md flex items-center justify-center border transition @(isSelected ? "bg-rose-600 border-rose-600 text-white" : "border-slate-300 bg-white")">
                                @if (isSelected) { <span class="text-xs font-bold">✓</span> }
                            </div>
                            <span class="text-sm font-semibold @(isSelected ? "text-rose-950" : "text-slate-700")">@allergen</span>
                        </div>
                        @if (isSelected)
                        {
                            <span class="text-[10px] font-bold text-rose-600 uppercase tracking-wider bg-rose-100/60 px-2 py-0.5 rounded-md">Avoid</span>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Prep Preferences -->
        <div>
            <span class="text-xs uppercase font-bold text-slate-400 tracking-wider block mb-3">Preparation Preferences</span>
            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-slate-700">Dedicated Fryer Only</span>
                    <button @onclick="Profile.ToggleFryer" class="w-11 h-6 rounded-full transition relative p-0.5 @(Profile.DedicatedFryerOnly ? "bg-emerald-600" : "bg-slate-200")">
                        <div class="w-5 h-5 rounded-full bg-white transition shadow-sm @(Profile.DedicatedFryerOnly ? "translate-x-5" : "translate-x-0")"></div>
                    </button>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-slate-700">Separate Prep Table</span>
                    <button @onclick="Profile.TogglePrep" class="w-11 h-6 rounded-full transition relative p-0.5 @(Profile.SeparatePrepTable ? "bg-emerald-600" : "bg-slate-200")">
                        <div class="w-5 h-5 rounded-full bg-white transition shadow-sm @(Profile.SeparatePrepTable ? "translate-x-5" : "translate-x-0")"></div>
                    </button>
                </div>
            </div>
        </div>

        <!-- Sensitivity Level -->
        <div>
            <span class="text-xs uppercase font-bold text-slate-400 tracking-wider block mb-2">Sensitivity Level</span>
            <div class="grid grid-cols-2 p-1 bg-slate-100 rounded-xl gap-1">
                <button @onclick="() => Profile.SetSensitivity(SensitivityLevel.StrictMedical)"
                        class="py-2 text-xs font-bold rounded-lg transition cursor-pointer @(Profile.Sensitivity == SensitivityLevel.StrictMedical ? "bg-white text-slate-900 shadow-2xs" : "text-slate-500 hover:text-slate-900")">
                    Strict Medical
                </button>
                <button @onclick="() => Profile.SetSensitivity(SensitivityLevel.MildSensitivity)"
                        class="py-2 text-xs font-bold rounded-lg transition cursor-pointer @(Profile.Sensitivity == SensitivityLevel.MildSensitivity ? "bg-white text-slate-900 shadow-2xs" : "text-slate-500 hover:text-slate-900")">
                    Mild Sensitivity
                </button>
            </div>
            <p class="mt-3 text-xs text-slate-400 leading-relaxed">
                Cross-contact matters. We prioritize dishes with verified prep protocols.
            </p>
            <div class="mt-2 text-xs text-emerald-700 font-semibold flex items-center gap-1.5">
                <span>✓</span> Preferences saved automatically
            </div>
        </div>
    </div>

    <!-- Single Trust Footer -->
    <div class="mt-8 pt-4 border-t border-slate-100">
        <div class="flex items-center gap-2 text-xs font-bold text-slate-900">
            <span>🛡</span> Transparency, not guesswork.
        </div>
        <p class="mt-1 text-[11px] text-slate-400 leading-relaxed">
            Menu information is supplied by the restaurant. Always confirm your allergies with the kitchen before ordering.
        </p>
        <button @onclick="() => Modals.Open(ActiveModal.SafetyLabels)" 
                class="mt-2 inline-block text-[11px] font-bold text-emerald-800 hover:text-emerald-900 hover:underline cursor-pointer">
            How our safety labels work ↗
        </button>
    </div>
</aside>

@code {
    protected override void OnInitialized() => Profile.OnProfileChanged += StateHasChanged;
    public void Dispose() => Profile.OnProfileChanged -= StateHasChanged;
}