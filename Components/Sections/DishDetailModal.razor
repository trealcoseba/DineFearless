@using System.Linq
@using DineFearless.Models
@using DineFearless.Services
@inject ModalService Modals
@inject UserDietaryProfile Profile
@inject SafePlateService PlateService
@implements IDisposable

@if (Modals.CurrentModal == ActiveModal.DishDetail && Modals.SelectedDish is not null)
{
    var dish = Modals.SelectedDish;
    var assessment = Profile.EvaluateItem(dish);
    var isAdded = PlateService.Contains(dish);

    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/60 backdrop-blur-sm p-4 animate-fade-in">
        <div class="bg-white rounded-3xl max-w-2xl w-full p-8 shadow-2xl border border-slate-200 max-h-[90vh] overflow-y-auto">
            
            <!-- Header & Close Button -->
            <div class="flex items-start justify-between pb-6 border-b border-slate-100">
                <div class="flex items-center gap-4">
                    <img src="@dish.ImageUrl" alt="@dish.Name" class="w-16 h-16 rounded-2xl object-cover border border-slate-200 shadow-xs" />
                    <div>
                        <div class="flex items-center gap-2">
                            <h2 class="text-2xl font-black text-slate-900">@dish.Name</h2>
                            <span class="text-lg font-bold text-slate-900">@dish.Price.ToString("C0")</span>
                        </div>
                        <p class="text-xs text-slate-500 mt-0.5">@dish.Description</p>
                    </div>
                </div>
                <button @onclick="Modals.Close" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center font-bold text-sm cursor-pointer">✕</button>
            </div>

            <!-- Safety Assessment Callout -->
            <div class="my-6 p-4 rounded-2xl border @GetCalloutStyle(assessment.Status)">
                <div class="flex items-center gap-2 font-bold text-sm mb-1">
                    <span>@GetCalloutIcon(assessment.Status)</span>
                    <span>Safety Evaluation for your Profile</span>
                </div>
                <p class="text-xs leading-relaxed">
                    @(assessment.UnsafeReason ?? assessment.ModificationNote ?? "All ingredients verified safe against your active profile.")
                </p>
            </div>

            <!-- Granular Ingredient Breakdown -->
            <div class="space-y-4">
                <h3 class="text-xs font-black uppercase tracking-wider text-slate-400">Full Ingredient Transparency</h3>
                
                <div class="grid grid-cols-1 gap-2.5">
                    @foreach (var ingredient in dish.GetIngredients())
                    {
                        var matchingAllergens = ingredient.GetContainedAllergens().Intersect(Profile.ActiveAllergens).ToList();
                        var hasMatch = matchingAllergens.Any();

                        <div class="p-3.5 rounded-2xl border transition flex items-center justify-between @(hasMatch ? "bg-rose-50/70 border-rose-200" : "bg-slate-50/80 border-slate-200/80")">
                            <div>
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-bold text-slate-900">@ingredient.Name</span>
                                    @if (ingredient.IsCertifiedSupplier)
                                    {
                                        <span class="text-[10px] bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded-md">Verified Source</span>
                                    }
                                </div>
                                <p class="text-[11px] text-slate-400 mt-0.5">@ingredient.OriginNotes</p>
                            </div>

                            <div>
                                @if (hasMatch)
                                {
                                    <span class="px-2.5 py-1 rounded-full text-[11px] font-black bg-rose-600 text-white shadow-2xs">
                                        Matches: @string.Join(", ", matchingAllergens)
                                    </span>
                                }
                                else
                                {
                                    <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-white text-emerald-800 border border-emerald-200">
                                        ✓ Safe
                                    </span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Kitchen Equipment Protocols -->
            @if (dish is FoodDish food)
            {
                <div class="mt-6 p-4 rounded-2xl bg-slate-50 border border-slate-200">
                    <h4 class="text-xs font-black uppercase tracking-wider text-slate-400 mb-2">Kitchen Handling Rigor</h4>
                    <div class="flex flex-wrap gap-4 text-xs font-semibold text-slate-700">
                        <span class="flex items-center gap-1.5 @(food.UsesDedicatedFryer ? "text-emerald-700" : "text-amber-700")">
                            @(food.UsesDedicatedFryer ? "✓ Dedicated Fryer Confirmed" : "⚠ Shared Oil Warning")
                        </span>
                        <span class="flex items-center gap-1.5 @(food.HasDedicatedPrepTable ? "text-emerald-700" : "text-amber-700")">
                            @(food.HasDedicatedPrepTable ? "✓ Separate Prep Station" : "⚠ Shared Prep Line")
                        </span>
                    </div>
                </div>
            }

            <!-- Bottom Actions -->
            <div class="mt-8 pt-4 border-t border-slate-100 flex items-center justify-between">
                <button @onclick="Modals.Close" class="px-6 py-3 rounded-xl border border-slate-200 text-slate-700 font-bold text-xs hover:bg-slate-50 cursor-pointer">
                    Close Inspector
                </button>

                @if (assessment.Status == AssessmentStatus.Safe)
                {
                    <button @onclick="() => { PlateService.Add(dish); Modals.Close(); }" 
                            class="px-8 py-3 bg-emerald-800 hover:bg-emerald-900 text-white font-bold text-xs rounded-xl shadow-xs transition cursor-pointer">
                        @(isAdded ? "Added to Plate ✓" : "+ Add Dish to Plate")
                    </button>
                }
                else if (assessment.Status == AssessmentStatus.Modifiable)
                {
                    <button @onclick="() => Modals.Open(ActiveModal.DishModification, dish)" 
                            class="px-8 py-3 bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs rounded-xl shadow-xs transition cursor-pointer">
                        Review Chef Modifications →
                    </button>
                }
                else
                {
                    <button disabled class="px-8 py-3 bg-slate-100 text-slate-400 font-bold text-xs rounded-xl cursor-not-allowed">
                        Unsafe for Profile
                    </button>
                }
            </div>

        </div>
    </div>
}

@code {
    protected override void OnInitialized() => Modals.OnModalChanged += StateHasChanged;
    public void Dispose() => Modals.OnModalChanged -= StateHasChanged;

    private string GetCalloutStyle(AssessmentStatus s) => s switch
    {
        AssessmentStatus.Safe => "bg-emerald-50 text-emerald-950 border-emerald-200",
        AssessmentStatus.Modifiable => "bg-amber-50 text-amber-950 border-amber-200",
        _ => "bg-rose-50 text-rose-950 border-rose-200"
    };

    private string GetCalloutIcon(AssessmentStatus s) => s switch
    {
        AssessmentStatus.Safe => "🛡",
        AssessmentStatus.Modifiable => "⚙",
        _ => "⚠"
    };
}