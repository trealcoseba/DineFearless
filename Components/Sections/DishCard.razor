@using DineFearless.Models
@using DineFearless.Services
@inject UserDietaryProfile Profile
@inject SafePlateService PlateService
@inject ModalService Modals
@implements IDisposable

@{
    var assessment = Profile.EvaluateItem(Dish);
    var isAdded = PlateService.Contains(Dish);
}

<div class="group flex flex-col justify-between rounded-3xl border transition-all duration-200 bg-white overflow-hidden shadow-xs hover:shadow-md @GetContainerClass(assessment.Status)">
    <div>
        <!-- Photo with Interactive Inspect Button -->
        <div class="relative h-48 w-full overflow-hidden cursor-pointer" @onclick="() => Modals.Open(ActiveModal.DishDetail, Dish)">
            <img src="@Dish.ImageUrl" alt="@Dish.Name" class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-300" />
            
            <!-- Safety Pill -->
            <div class="absolute top-3 left-3">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black backdrop-blur-md shadow-sm @GetBadgeClass(assessment.Status)">
                    <span>@GetBadgeIcon(assessment.Status)</span> @assessment.BadgeText
                </span>
            </div>

            <!-- Inspect Hover Tag -->
            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                <span class="bg-white/95 text-slate-900 text-xs font-extrabold px-3.5 py-1.5 rounded-full shadow-md flex items-center gap-1.5">
                    🔍 Inspect Ingredients
                </span>
            </div>
        </div>

        <!-- Details -->
        <div class="p-5">
            <div class="flex items-center justify-between">
                <h4 class="text-lg font-bold text-slate-900 group-hover:text-emerald-900 transition">@Dish.Name</h4>
                <span class="text-base font-bold text-slate-900">@Dish.Price.ToString("C0")</span>
            </div>
            <p class="mt-1 text-xs text-slate-500 leading-relaxed">@Dish.Description</p>

            <!-- Status Context Blocks -->
            @if (assessment.Status == AssessmentStatus.Safe && Dish is FoodDish food)
            {
                <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                    <span class="flex items-center gap-1.5 font-bold text-emerald-800">
                        <span>🛡</span> Dedicated Fryer
                    </span>
                    <button @onclick="() => Modals.Open(ActiveModal.DishDetail, Dish)" class="text-[11px] text-slate-400 hover:text-emerald-800 font-bold underline cursor-pointer">
                        @Dish.GetIngredients().Count ingredients
                    </button>
                </div>
            }
            else if (assessment.Status == AssessmentStatus.Modifiable)
            {
                <div class="mt-4 rounded-xl bg-amber-50/80 border border-amber-200/60 p-3 flex items-start justify-between gap-2">
                    <div>
                        <div class="text-[10px] uppercase font-bold text-amber-800 tracking-wider">Make it yours</div>
                        <p class="mt-0.5 text-xs font-semibold text-amber-900">@assessment.ModificationNote</p>
                    </div>
                    <span class="text-amber-600 text-xs">⚙</span>
                </div>
            }
            else if (assessment.Status == AssessmentStatus.Unsafe)
            {
                <div class="mt-4 rounded-xl bg-rose-50/80 border border-rose-200/60 p-3">
                    <div class="text-[10px] uppercase font-bold text-rose-700 tracking-wider">Not safe for your profile</div>
                    <p class="mt-0.5 text-xs font-medium text-rose-800">@assessment.UnsafeReason</p>
                </div>
            }
        </div>
    </div>

    <!-- Actions -->
    <div class="p-5 pt-0">
        @if (assessment.Status == AssessmentStatus.Safe)
        {
            <button @onclick="TogglePlate"
                    class="w-full py-3 rounded-xl font-bold text-sm transition flex items-center justify-center gap-2 cursor-pointer shadow-xs @(isAdded ? "bg-emerald-950 text-white hover:bg-rose-800" : "bg-emerald-800 hover:bg-emerald-900 text-white")">
                <span>@(isAdded ? "✓ Added to plate" : "+ Add to plate")</span>
            </button>
        }
        else if (assessment.Status == AssessmentStatus.Modifiable)
        {
            <button @onclick="() => Modals.Open(ActiveModal.DishModification, Dish)"
                    class="w-full py-3 rounded-xl font-bold text-sm border border-slate-300 text-slate-700 hover:bg-slate-50 transition flex items-center justify-center gap-2 cursor-pointer">
                <span>⚙</span> Review modifications
            </button>
        }
        else
        {
            <button disabled class="w-full py-3 rounded-xl font-bold text-sm bg-slate-100 text-slate-400 cursor-not-allowed">
                ⊘ Not available for you
            </button>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public MenuItem Dish { get; set; } = default!;

    protected override void OnInitialized()
    {
        PlateService.OnPlateChanged += StateHasChanged;
        Profile.OnProfileChanged += StateHasChanged;
    }

    public void Dispose()
    {
        PlateService.OnPlateChanged -= StateHasChanged;
        Profile.OnProfileChanged -= StateHasChanged;
    }

    private void TogglePlate()
    {
        if (PlateService.Contains(Dish)) PlateService.Remove(Dish);
        else PlateService.Add(Dish);
    }

    private string GetContainerClass(AssessmentStatus s) => s switch
    {
        AssessmentStatus.Safe => "border-slate-200",
        AssessmentStatus.Modifiable => "border-amber-200/80",
        AssessmentStatus.Unsafe => "border-rose-200 opacity-70",
        _ => "border-slate-200"
    };

    private string GetBadgeClass(AssessmentStatus s) => s switch
    {
        AssessmentStatus.Safe => "bg-white text-emerald-800",
        AssessmentStatus.Modifiable => "bg-amber-100 text-amber-900",
        AssessmentStatus.Unsafe => "bg-rose-100 text-rose-800",
        _ => "bg-slate-100 text-slate-800"
    };

    private string GetBadgeIcon(AssessmentStatus s) => s switch
    {
        AssessmentStatus.Safe => "●",
        AssessmentStatus.Modifiable => "▲",
        AssessmentStatus.Unsafe => "✕",
        _ => "•"
    };
}