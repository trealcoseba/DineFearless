@using DineFearless.Models
@using DineFearless.Services
@inject ModalService Modals

<div class="relative overflow-hidden rounded-3xl h-64 shadow-xs border border-slate-200">
    <img src="@Restaurant.BannerImageUrl" alt="@Restaurant.Name" class="w-full h-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-black/10 flex flex-col justify-between p-8 text-white">
        <!-- Top Tags -->
        <div class="flex justify-end">
            <button @onclick="() => Modals.Open(ActiveModal.KitchenProtocols)" 
                    class="inline-flex items-center gap-1.5 bg-white/95 backdrop-blur-md text-emerald-800 font-bold text-xs px-3 py-1.5 rounded-full shadow-md hover:bg-white transition cursor-pointer">
                <span>🛡</span> Certified Protocols
            </button>
        </div>

        <!-- Restaurant Metadata -->
        <div>
            <h1 class="text-3xl font-extrabold tracking-tight">@Restaurant.Name</h1>
            <p class="mt-1 text-sm text-slate-200">@Restaurant.Category • @Restaurant.Neighborhood • @Restaurant.Distance</p>
            <div class="mt-3 flex items-center gap-4 text-xs font-medium text-slate-300">
                <span class="text-amber-400 font-bold">★ @Restaurant.Rating (@Restaurant.ReviewCount allergy-aware reviews)</span>
                <span>•</span>
                <span class="flex items-center gap-1 text-emerald-400">
                    <span class="h-2 w-2 rounded-full bg-emerald-400"></span> @Restaurant.Hours
                </span>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Restaurant Restaurant { get; set; } = default!;
}